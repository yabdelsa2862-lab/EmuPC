+// MADEIRA straddling writes: a store that starts in the last bytes of a page and ends in
+// the next one faults with the address of its first byte. Only the first page was
+// untrapped, so the store faulted again at the same address, forever: R.E.P.O. (Unity,
+// Mono) froze loading a level with 2.4 million write faults at one pc on ...3FFF. The
+// next page is handled as its own fault too (it returns at once when that page is not
+// tracked). A store is at most 16 bytes here (SIMD q registers; stp is two 8-byte halves).
+void InvalidationTracker::HandleStraddlingWrite(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPc,
+                                                uint64_t FaultAddress, bool* HotPage) {
+  const uint64_t Next = (FaultAddress + 15) & FEXCore::Utils::FEX_PAGE_MASK;
+  if (Next <= FaultAddress) {
+    return;
+  }
+  static std::atomic<uint32_t> LogCount {0};
+  if (LogCount.fetch_add(1, std::memory_order_relaxed) < 8) {
+    LogMan::Msg::EFmt("[smc-straddle] write at {:#x} reaches page {:#x}: untrapping it too", FaultAddress, Next);
+  }
+  HandleRWXAccessViolation(Thread, HostPc, Next, HotPage);
+}
+
 bool InvalidationTracker::BeginUntrackedWriteLocked(uint64_t Address, uint64_t Size) {
   return ProtectRWXIntervalsInternal(Address, Size, true);
 }
