LIBRARY libarm64ecfex.dll

EXPORTS
  BTCpu64FlushInstructionCache
  BTCpu64IosReleaseThreadHolds
  BTCpu64IsProcessorFeaturePresent
  BTCpu64NotifyMemoryDirty
  BTCpu64NotifyReadFile
  DispatchJump DATA
